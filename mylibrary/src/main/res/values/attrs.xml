<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="DsButton">
        <attr name="textDS" format="string" />
        <attr name="buttonType" format="enum">
            <enum name="primary" value="0"/>
            <enum name="secondary" value="1"/>
            <enum name="outlined" value="2"/>
            <enum name="text" value="3"/>
            <enum name="danger" value="4"/>
        </attr>
        <attr name="iconStart" format="reference"/>
        <attr name="iconEnd" format="reference"/>
        <attr name="backgroundColorDS" format="color|reference"/>
        <attr name="textColorDS" format="color|reference"/>
    </declare-styleable>

    <declare-styleable name="DsNotificationCard">
        <attr name="notificationTitle" format="string" />
        <attr name="notificationDateTime" format="string" />
        <attr name="isNew" format="boolean" />
    </declare-styleable>


    <declare-styleable name="DsInput">
        <attr name="android:hint"/>
        <attr name="android:textColor"/>
        <attr name="android:textColorHint"/>
        <attr name="android:text"/>
        <attr name="android:maxLength"/>
        <attr name="android:inputType"/>


        <attr name="inputKeyboardType" format="enum">
            <enum name="cpf" value="1"/>
            <enum name="number" value="2"/>
            <enum name="phone" value="3"/>
            <enum name="email" value="4"/>
            <enum name="password" value="5"/>
            <enum name="date" value="6"/>
            <enum name="text" value="7"/>
        </attr>
    </declare-styleable>

    <declare-styleable name="DsText">
        <attr name="dsFontWeight" format="enum">
            <enum name="regular" value="0" />
            <enum name="semiBold" value="1" />
            <enum name="bold" value="2" />
            <enum name="medium" value="3" />
        </attr>
        <attr name="dsTextStyle" format="enum">
            <enum name="header" value="0" />
            <enum name="subtitle" value="1" />
            <enum name="description" value="2" />
            <enum name="text" value="3" />
        </attr>
    </declare-styleable>

    <declare-styleable name="DsChip">
        <attr name="chipText" format="string" />
        <attr name="chipBackgroundColorDS" format="color|reference" />
        <attr name="chipTextColorDS" format="color|reference" />
    </declare-styleable>
</resources>
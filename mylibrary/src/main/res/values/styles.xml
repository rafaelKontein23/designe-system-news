<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="DsButton" parent="Widget.Material3.Button">
        <item name="android:textSize">@dimen/font_size</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="shapeAppearanceOverlay">@style/DsButton.Shape</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="DsButton.Shape">
        <item name="cornerSize">@dimen/border_button_radius</item>
    </style>

    <style name="DsEditText">
        <item name="android:textSize">@dimen/font_size_12</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textColorHint">@color/black_100</item>
        <item name="android:textColor">@color/black_150</item>
        <item name="android:paddingStart">@dimen/padding_4</item>
    </style>

    <style name="TextAppearance.Toolbar.Title.Header" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textSize">24sp</item>
        <item name="fontFamily">@font/poppins_bold</item>
    </style>

    <style name="TextAppearance.Toolbar.Title.Subtitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textSize">14sp</item>
        <item name="fontFamily">@font/poppins_semibold</item>
    </style>
    <style name="ShapeAppearance.Ds.SmallComponent" parent="">
        <item name="cornerSize">12dp</item>
    </style>
</resources>